# Electron App — Environment Variables
# Copy to .env and fill in values for local dev.
# Production builds use VITE_API_URL baked in at build time (or CQ_API_URL at launch).

# ─── Backend API (required) ──────────────────────────────────────────────────
# URL of the Railway (or local) backend.
# For production builds this is stamped at build time by `VITE_API_URL`.
# Can also be overridden at launch via the OS env var `CQ_API_URL` (e.g. in a
# shell wrapper or Windows .bat file) without needing to rebuild the binary.
VITE_API_URL=https://your-app.up.railway.app

# ─── Runtime override (optional, production only) ────────────────────────────
# Setting CQ_API_URL in the OS environment before launching the packaged .exe
# or .app will override the compile-time VITE_API_URL. Useful for contest-day
# URL changes without recompiling.
# CQ_API_URL=https://your-app.up.railway.app

# ─── Dev server (populated automatically by vite-plugin-electron) ────────────
# VITE_DEV_SERVER_URL is set by the dev plugin at runtime — do not set manually.
