# Campus Quest Platform — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env (local dev) or configure variables in Railway/Vercel.
# NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED. Railway PostgreSQL provides this as $DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_quest"

# ─── Redis (BullMQ Queue) ─────────────────────────────────────────────────────
# REQUIRED. Railway Redis provides this as $REDIS_URL automatically.
# When REDIS_URL is set it takes priority over REDIS_HOST/REDIS_PORT.
REDIS_URL="redis://localhost:6379"

# Alternative: configure host and port separately (used if REDIS_URL is absent)
# REDIS_HOST="localhost"
# REDIS_PORT="6379"

# ─── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Change both values before deploying. Use a random 32-byte hex string.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT signing key for contestant sessions (12h expiry)
JWT_SECRET="REPLACE-WITH-RANDOM-32-BYTE-HEX"

# Admin portal password. Entered in the admin login form.
# This is NOT stored in the DB — it is compared directly in the backend.
ADMIN_SECRET="REPLACE-WITH-STRONG-ADMIN-PASSWORD"

# ─── Server ──────────────────────────────────────────────────────────────────
# Railway sets PORT automatically. Do not set it manually on Railway.
PORT="3001"
HOST="0.0.0.0"
NODE_ENV="production"

# Allowed CORS origins (comma-separated list of full URLs, no trailing slashes).
# Add your Vercel admin deployment URL here.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://your-admin-app.vercel.app"

# ─── Judge Worker ─────────────────────────────────────────────────────────────
# Set to 'true' if running a split-service architecture where the API and judge
# worker are separate Railway services. Leave false for single-service deploys.
DISABLE_JUDGE_WORKER="false"

# How many submissions the judge worker processes simultaneously.
# Increase on larger Railway plans (more vCPUs). Default: 4.
JUDGE_CONCURRENCY="4"

# ─── Problems Directory ───────────────────────────────────────────────────────
# Set automatically in the Dockerfile to /app/problems.
# Override only if mounting problems from an external volume.
PROBLEMS_DIR="/app/problems"

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Enables /demo/* endpoints for board presentations.
# Set to 'false' (or leave unset) for the real contest.
DEMO_MODE="false"

# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY DEPLOYMENT GUIDE
# ═══════════════════════════════════════════════════════════════════════════════
# Service:        campus-quest-backend
# Root Directory: /   (monorepo root)
# Build Command:  docker build -t campus-quest .
# Start Command:  Defined in railway.json / Dockerfile CMD
# Health Check:   GET /health
# Detailed Check: GET /health/detailed   (shows DB, Redis, worker, problem count)
#
# Required Railway Variables:
#   DATABASE_URL   → auto-filled by Railway PostgreSQL plugin
#   REDIS_URL      → auto-filled by Railway Redis plugin
#   JWT_SECRET     → set manually
#   ADMIN_SECRET   → set manually
#   CORS_ORIGINS   → set to your Vercel admin URL
#   NODE_ENV       → production
#
# ═══════════════════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT GUIDE (admin panel)
# ═══════════════════════════════════════════════════════════════════════════════
# Root Directory: apps/admin
# Framework:      Vite
# Build Command:  npm run build
# Output Dir:     dist
#
# Required Vercel Variables:
#   VITE_API_URL   → https://<your-railway-service>.up.railway.app
#                    (no trailing slash)
#
# ═══════════════════════════════════════════════════════════════════════════════
# ELECTRON PRODUCTION BUILD GUIDE
# ═══════════════════════════════════════════════════════════════════════════════
# The Electron app has the backend URL baked in at build time via Vite.
# Set VITE_API_URL in apps/electron/.env.production before building.
# Contestants can override at runtime using the CQ_API_URL OS environment var.
#
# macOS:  CQ_API_URL=https://... open /Applications/CampusQuest.app
# Windows: set CQ_API_URL=https://... && CampusQuest.exe
#
# Build commands (from apps/electron/):
#   npm run build:mac      → dist-electron/mac/*.dmg
#   npm run build:win      → dist-electron/win-unpacked/*.exe  (requires Windows runner)
# ═══════════════════════════════════════════════════════════════════════════════
